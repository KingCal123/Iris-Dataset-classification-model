{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/confusion_matrix.png",
      "dest": "/public/confusion_matrix.png"
    },
    {
      "src": "/roc_curves.png",
      "dest": "/public/roc_curves.png"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
